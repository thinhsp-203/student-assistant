GOOGLE_API_KEY=your-google-api-key
# GEMINI_API_KEY is also supported; use one key variable, not an OAuth token.
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
SQLITE_DATABASE_URL=./data/students.db
# Set these to models enabled for the Google account/API key.
LLM_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=models/text-embedding-005
RETRIEVAL_TOP_K=5
