GOOGLE_API_KEY=your-google-api-key
# GEMINI_API_KEY is also supported; use one key variable, not an OAuth token.
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
# Leave DATABASE_URL empty for local SQLite. PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://user:password@localhost/student_assistant
DATABASE_URL=
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Set these to models enabled for the Google account/API key.
LLM_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=models/text-embedding-005
RETRIEVAL_TOP_K=5
